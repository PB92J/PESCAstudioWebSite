{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: avvia preview locale",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Configuration file:",
          "endsPattern": "Server running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
